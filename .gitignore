# Go
# Built frontend assets, copied here by `make build` for go:embed.
# .gitkeep stays tracked so `go:embed all:public` compiles in a fresh
# clone or worktree, where no build has run yet.
server/cmd/kpanel/public/*
!server/cmd/kpanel/public/.gitkeep
*.exe
*.exe~
*.dll
*.so
*.dylib

# Bun/Node
web/node_modules/
web/dist/
web/sfw bun install/

# Build output
dist/
server/kafkaseed
server/kpanel

# Config (don't commit local/private runtime data)
.kpanel/
.private/

# Environment
.env
.env.local
.env.*.local

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/settings.json
.idea/
*.swp
*.swo

# Logs
*.log

# TypeScript
*.tsbuildinfo
server/cmd/kafkaseed/kafkaseed
